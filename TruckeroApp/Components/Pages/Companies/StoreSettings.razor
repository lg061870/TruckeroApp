    <script>
        window.addEventListener('load', function() {
            const navLinks = document.querySelectorAll('#settings-nav a');
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    navLinks.forEach(l => {
                        l.classList.remove('bg-truckero-orange-light', 'text-truckero-orange', 'font-semibold');
                        l.classList.add('text-truckero-gray-700', 'font-medium');
                    });
                    this.classList.add('bg-truckero-orange-light', 'text-truckero-orange', 'font-semibold');
                    this.classList.remove('text-truckero-gray-700', 'font-medium');
                });
            });
        });
    </script>

