@using Microsoft.AspNetCore.Components
@using Truckero.Core.DTOs
@using TruckeroApp.Components.Pages.Companies

<div class="space-y-4">
    <h4 class="text-xl font-semibold text-truckero-gray-900">
        @(FormMode == StoreFormMode.Edit ? "Edit Store" : "New Store")
    </h4>

    <div>
        <label class="block text-sm font-semibold text-truckero-gray-700 mb-1">Store Name</label>
        <input class="w-full h-11 px-3 border border-truckero-gray-200 rounded-lg"
               value="@Store.Name"
               @oninput="HandleNameChanged" />
    </div>

    <div>
        <label class="block text-sm font-semibold text-truckero-gray-700 mb-1">Address</label>
        <input class="w-full h-11 px-3 border border-truckero-gray-200 rounded-lg"
               value="@Store.Address"
               @oninput="HandleAddressChanged" />
    </div>

    <div>
        <label class="block text-sm font-semibold text-truckero-gray-700 mb-1">Region</label>
        <input class="w-full h-11 px-3 border border-truckero-gray-200 rounded-lg"
               value="@Store.Region"
               @oninput="HandleRegionChanged" />
    </div>

    <div class="flex justify-end space-x-2 mt-4">
        <button type="button"
                class="h-10 px-4 bg-white border border-truckero-gray-300 rounded-lg text-sm"
                @onclick="OnCancelClicked">
            Cancel
        </button>
        <button type="button"
                class="h-10 px-4 bg-truckero-green text-white rounded-lg text-sm"
                @onclick="OnSaveClicked">
            Save Store
        </button>
    </div>
</div>

@code {
    [Parameter] public StoreRequest Store { get; set; } = new();
    [Parameter] public StoreFormMode FormMode { get; set; } = StoreFormMode.New;

    [Parameter] public EventCallback<StoreRequest> OnStoreSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task HandleNameChanged(ChangeEventArgs e)
    {
        Store.Name = e.Value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleAddressChanged(ChangeEventArgs e)
    {
        Store.Address = e.Value?.ToString();
        return Task.CompletedTask;
    }

    private Task HandleRegionChanged(ChangeEventArgs e)
    {
        Store.Region = e.Value?.ToString();
        return Task.CompletedTask;
    }

    private Task OnCancelClicked() => OnCancel.HasDelegate ? OnCancel.InvokeAsync() : Task.CompletedTask;

    private Task OnSaveClicked() => OnStoreSaved.HasDelegate ? OnStoreSaved.InvokeAsync(Store) : Task.CompletedTask;
}
