    <!-- Add Clerk Modal -->
    <div id="add-clerk-modal" class="fixed inset-0 bg-truckero-gray-900/50 z-30 flex items-center justify-center hidden transition-opacity duration-300 opacity-0">
        <div id="modal-content" class="bg-white rounded-2xl shadow-2xl w-full max-w-lg transform scale-95 transition-all duration-300">
            <div class="flex items-center justify-between p-6 border-b border-truckero-gray-200">
                <h3 class="text-xl font-bold text-truckero-gray-900">Create New Clerk Account</h3>
                <button id="close-modal-button" class="text-truckero-gray-400 hover:text-truckero-gray-700 text-2xl h-11 w-11 flex items-center justify-center rounded-full hover:bg-truckero-gray-100">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="p-8">
                <div class="bg-truckero-orange-light text-truckero-orange-700 px-4 py-3 rounded-lg mb-6 flex items-center space-x-3">
                    <i class="fa-solid fa-store"></i>
                    <p class="font-semibold">Registering as: <span class="uppercase">Store Clerk</span></p>
                </div>
                <form id="add-clerk-form" class="space-y-6">
                    <div>
                        <label for="clerk-name" class="block text-sm font-medium text-truckero-gray-700 mb-2">Full Name</label>
                        <input type="text" id="clerk-name" placeholder="Enter clerk's full name" class="w-full px-4 py-3 border border-truckero-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-truckero-orange/50 transition-shadow">
                    </div>
                    <div>
                        <label for="clerk-email" class="block text-sm font-medium text-truckero-gray-700 mb-2">Email Address</label>
                        <input type="email" id="clerk-email" placeholder="Enter clerk's email address" class="w-full px-4 py-3 border border-truckero-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-truckero-orange/50 transition-shadow">
                    </div>
                    <div>
                        <label for="clerk-store" class="block text-sm font-medium text-truckero-gray-700 mb-2">Store Assignment</label>
                        <div class="relative">
                            <select id="clerk-store" class="appearance-none w-full px-4 py-3 border border-truckero-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-truckero-orange/50 transition-shadow bg-white">
                                <option>Select a store</option>
                                <option>Downtown Main St</option>
                                <option>Northside Plaza</option>
                                <option>West End Mall</option>
                            </select>
                            <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-truckero-gray-400 pointer-events-none"></i>
                        </div>
                    </div>
                    <div>
                        <label for="clerk-password" class="block text-sm font-medium text-truckero-gray-700 mb-2">Temporary Password</label>
                        <input type="password" id="clerk-password" placeholder="Auto-generated password" class="w-full px-4 py-3 border border-truckero-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-truckero-orange/50 transition-shadow">
                        <p class="text-xs text-truckero-gray-500 mt-2">The clerk will be required to change their password on first login.</p>
                    </div>
                </form>
            </div>
            <div class="flex items-center justify-end space-x-4 p-6 border-t border-truckero-gray-200">
                <button id="cancel-button" class="h-12 px-6 bg-truckero-gray-100 text-truckero-gray-700 font-semibold rounded-lg hover:bg-truckero-gray-200 transition-all duration-200">
                    Cancel
                </button>
                <button id="create-clerk-button" class="h-12 px-6 bg-truckero-orange text-white font-semibold rounded-lg hover:bg-orange-600 transition-all duration-200 flex items-center space-x-2">
                    <i class="fa-solid fa-check"></i>
                    <span>Create Account</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        // Modal functionality
        const addClerkButton = document.getElementById('add-clerk-button');
        const closeModalButton = document.getElementById('close-modal-button');
        const cancelButton = document.getElementById('cancel-button');
        const addClerkModal = document.getElementById('add-clerk-modal');
        const modalContent = document.getElementById('modal-content');

        function openModal() {
            addClerkModal.classList.remove('hidden');
            setTimeout(() => {
                addClerkModal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
                modalContent.classList.add('scale-100');
            }, 10);
        }

        function closeModal() {
            addClerkModal.classList.add('opacity-0');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-95');
            setTimeout(() => {
                addClerkModal.classList.add('hidden');
            }, 300);
        }

        addClerkButton.addEventListener('click', openModal);
        closeModalButton.addEventListener('click', closeModal);
        cancelButton.addEventListener('click', closeModal);

        addClerkModal.addEventListener('click', function(e) {
            if (e.target === addClerkModal) {
                closeModal();
            }
        });

        // Form submission
        const createClerkButton = document.getElementById('create-clerk-button');
        createClerkButton.addEventListener('click', function() {
            // Form validation and submission logic here
            alert('Clerk account created successfully!');
            closeModal();
        });
    </script>
</div>

