<div class="store-asset-frame">
    <iframe class="store-asset-iframe" src="@Source" title="@Title" loading="eager" referrerpolicy="no-referrer"></iframe>
</div>

@code {
    [Parameter, EditorRequired]
    public string Source { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = "Store Screen";
}